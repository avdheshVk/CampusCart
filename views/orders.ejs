<%- include('partials/header') %>

<h1>My Orders</h1>

<% const placedOrder = placedId ? orders.find(o => String(o.id) === String(placedId)) : null; %>
<% if (placedOrder && placedOrder.payment_status === 'paid') { %>
  <p class="success-msg">Payment received &mdash; Order #<%= placedOrder.id %> placed successfully!</p>
<% } %>

<% if (orders.length === 0) { %>
  <p class="empty-state">You haven't placed any orders yet. <a href="/">Start shopping</a></p>
<% } else { %>
  <% orders.forEach(order => { %>
    <div class="order-card">
      <div class="order-header">
        <h3>Order #<%= order.id %></h3>
        <span class="order-status <%= order.payment_status === 'pending' ? 'pending' : '' %>"><%= order.status === 'pending_payment' ? 'awaiting payment' : order.status %></span>
      </div>
      <p class="order-date"><%= order.created_at %></p>
      <ul class="order-items">
        <% order.items.forEach(item => { %>
          <li><%= item.product_name %> &times; <%= item.quantity %> &mdash; ₹<%= (item.price * item.quantity).toFixed(2) %></li>
        <% }) %>
      </ul>
      <p class="order-total">Total: ₹<%= order.total.toFixed(2) %></p>
      <% if (order.payment_status === 'paid') { %>
        <p class="order-payment">Paid via <%= order.payment_method %> &middot; Ref <%= order.payment_ref %></p>
      <% } else if (order.payment_status === 'pending') { %>
        <p class="order-payment"><a href="/pay/<%= order.id %>" class="pay-now-link">Pay now &rarr;</a></p>
      <% } %>
    </div>
  <% }) %>
<% } %>

<%- include('partials/footer') %>
