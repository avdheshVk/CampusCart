<%- include('../partials/header') %>

<h1><%= product && product.id ? 'Edit Product' : 'Add Product' %></h1>
<% if (error) { %><p class="error-msg"><%= error %></p><% } %>

<form method="POST" action="<%= product && product.id ? '/admin/products/' + product.id + '/edit' : '/admin/products/new' %>" class="auth-form">
  <label>Name</label>
  <input type="text" name="name" value="<%= product ? product.name : '' %>" required>

  <label>Description</label>
  <textarea name="description" rows="4"><%= product ? product.description : '' %></textarea>

  <label>Price (₹)</label>
  <input type="number" step="0.01" name="price" value="<%= product ? product.price : '' %>" required>

  <label>Category</label>
  <input type="text" name="category" value="<%= product ? product.category : '' %>" required>

  <label>Image URL</label>
  <input type="text" name="image_url" value="<%= product ? product.image_url : '' %>">

  <label>Stock</label>
  <input type="number" name="stock" value="<%= product ? product.stock : 0 %>">

  <button type="submit"><%= product && product.id ? 'Save Changes' : 'Add Product' %></button>
</form>

<%- include('../partials/footer') %>
