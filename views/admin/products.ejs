<%- include('../partials/header') %>

<div class="page-header">
  <h1>Admin: Manage Products</h1>
  <a href="/admin/products/new" class="add-btn">+ Add Product</a>
</div>

<table class="admin-table">
  <thead>
    <tr>
      <th>Image</th>
      <th>Name</th>
      <th>Category</th>
      <th>Price</th>
      <th>Stock</th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    <% products.forEach(p => { %>
      <tr>
        <td><img src="<%= p.image_url %>" alt="<%= p.name %>" class="admin-thumb"></td>
        <td><%= p.name %></td>
        <td><%= p.category %></td>
        <td>₹<%= p.price.toFixed(2) %></td>
        <td><%= p.stock %></td>
        <td class="admin-actions">
          <a href="/admin/products/<%= p.id %>/edit">Edit</a>
          <form method="POST" action="/admin/products/<%= p.id %>/delete" onsubmit="return confirm('Delete this product?');">
            <button type="submit" class="remove-btn">Delete</button>
          </form>
        </td>
      </tr>
    <% }) %>
  </tbody>
</table>

<%- include('../partials/footer') %>
